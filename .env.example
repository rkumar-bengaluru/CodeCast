# Copy to .env (git-ignored) and uncomment what you need. Variables already set in your shell win over this file.

# Video length window in seconds checked after the narration is spoken (default 50 - 300).
# CODECAST_DURATION_MIN_S=50
# CODECAST_DURATION_MAX_S=300

# Spoken-word limits for the whole narration (defaults 110 / 200, aim 155).
# Raise these together with the duration if you want longer videos; about 2.5 words per second.
# CODECAST_MIN_WORDS=110
# CODECAST_MAX_WORDS=200
# CODECAST_TARGET_WORDS=155

# Number of scenes in the storyboard, title and outro included (defaults 4 / 10).
# Long screen-recording videos need more; every scene needs at least one narration sentence, so raise the words too.
# CODECAST_MIN_SCENES=4
# CODECAST_MAX_SCENES=10

# A custom piper voice (.onnx; its .onnx.json must sit next to it). --voice-model on the command line wins.
# CODECAST_VOICE_MODEL="voices/my-voice.onnx"

# API key for the configured LLM provider can live here too.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
